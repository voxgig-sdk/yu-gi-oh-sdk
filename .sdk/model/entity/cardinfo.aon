# Entity: cardinfo

main: kit: entity: cardinfo: {

  alias: field: {}

  fields: [
    {
      name: "archetype"
      req: false
      short: "The archetype the card belongs to"
      type: "`$STRING`"
    }
    {
      name: "atk"
      req: false
      short: "ATK value (Monster cards only)"
      type: "`$INTEGER`"
    }
    {
      name: "attribute"
      req: false
      short: "Attribute of the card (Monster cards only: DARK, LIGHT, WATER, FIRE, EARTH, WIND, DIVINE)"
      type: "`$STRING`"
    }
    {
      name: "banlist_info"
      req: false
      short: "Banlist status information for the card"
      type: "`$OBJECT`"
    }
    {
      name: "beta_name"
      req: false
      short: "Old/temporary/translated name (only when misc=yes)"
      type: "`$STRING`"
    }
    {
      name: "card_images"
      req: false
      short: "Array of card images including alternate artworks"
      type: "`$ARRAY`"
    }
    {
      name: "card_prices"
      req: false
      short: "Array of card prices from various vendors (lowest price across all versions)"
      type: "`$ARRAY`"
    }
    {
      name: "card_sets"
      req: false
      short: "Array of card sets this card appears in"
      type: "`$ARRAY`"
    }
    {
      name: "def"
      req: false
      short: "DEF value (Monster cards only, not Link Monsters)"
      type: "`$INTEGER`"
    }
    {
      name: "desc"
      req: true
      short: "Card description/effect text"
      type: "`$STRING`"
    }
    {
      name: "downvotes"
      req: false
      short: "Number of downvotes (only when misc=yes)"
      type: "`$INTEGER`"
    }
    {
      name: "formats"
      req: false
      short: "Available formats the card is in (only when misc=yes)"
      type: "`$ARRAY`"
    }
    {
      name: "frameType"
      req: true
      short: "The backdrop frame type (normal, effect, synchro, xyz, spell, trap, link, etc.)"
      type: "`$STRING`"
    }
    {
      name: "genesys_points"
      req: false
      short: "Genesys format points code (only when format=genesys)."
      type: "`$INTEGER`"
    }
    {
      name: "has_effect"
      req: false
      short: "Whether card has an actual text effect (1=true, 0=false) (only when misc=yes)"
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: true
      short: "8-digit passcode/ID of the card"
      type: "`$INTEGER`"
    }
    {
      name: "konami_id"
      req: false
      short: "Konami ID of the card (only when misc=yes)"
      type: "`$INTEGER`"
    }
    {
      name: "level"
      req: false
      short: "Level or RANK of the card (Monster cards only, not Link Monsters)"
      type: "`$INTEGER`"
    }
    {
      name: "linkmarkers"
      req: false
      short: "Link Markers (Link Monsters only)"
      type: "`$ARRAY`"
    }
    {
      name: "linkval"
      req: false
      short: "Link value (Link Monsters only)"
      type: "`$INTEGER`"
    }
    {
      name: "md_rarity"
      req: false
      short: "Master Duel rarity (only when misc=yes)"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      short: "Name of the card"
      type: "`$STRING`"
    }
    {
      name: "ocg_date"
      req: false
      short: "Original OCG release date (only when misc=yes)"
      type: "`$STRING`"
    }
    {
      name: "race"
      req: false
      short: "Card race/type."
      type: "`$STRING`"
    }
    {
      name: "scale"
      req: false
      short: "Pendulum Scale value (Pendulum Monsters only)"
      type: "`$INTEGER`"
    }
    {
      name: "tcg_date"
      req: false
      short: "Original TCG release date (only when misc=yes)"
      type: "`$STRING`"
    }
    {
      name: "treated_as"
      req: false
      short: "If the card is treated as another card (e.g., Harpie Lady 1,2,3 are treated as Harpie Lady) (only when misc=yes)"
      type: "`$STRING`"
    }
    {
      name: "type"
      req: true
      short: "The type of card (Normal Monster, Effect Monster, Synchro Monster, XYZ Monster, Spell Card, Trap Card, etc.)"
      type: "`$STRING`"
    }
    {
      name: "upvotes"
      req: false
      short: "Number of upvotes (only when misc=yes)"
      type: "`$INTEGER`"
    }
    {
      name: "views"
      req: false
      short: "Number of times card has been viewed in database (only when misc=yes)"
      type: "`$INTEGER`"
    }
    {
      name: "viewsweek"
      req: false
      short: "Number of times card has been viewed this week (only when misc=yes)"
      type: "`$INTEGER`"
    }
    {
      name: "ygoprodeck_url"
      req: false
      short: "URL to the card's page on YGOPRODeck"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "cardinfo"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: "Blue-Eyes"
                kind: "query"
                name: "archetype"
                orig: "archetype"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "2100"
                kind: "query"
                name: "atk"
                orig: "atk"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "WIND"
                kind: "query"
                name: "attribute"
                orig: "attribute"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "tcg"
                kind: "query"
                name: "banlist"
                orig: "banlist"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "Metal Raiders"
                kind: "query"
                name: "cardset"
                orig: "cardset"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "tcg"
                kind: "query"
                name: "dateregion"
                orig: "dateregion"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "2000"
                kind: "query"
                name: "def"
                orig: "def"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "2002-08-23"
                kind: "query"
                name: "enddate"
                orig: "enddate"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "Wizard"
                kind: "query"
                name: "fname"
                orig: "fname"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "Speed Duel"
                kind: "query"
                name: "format"
                orig: "format"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "has_effect"
                orig: "has_effect"
                reqd: false
                type: "`$BOOLEAN`"
              }
              {
                example: "6983839"
                kind: "query"
                name: "id"
                orig: "id"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "konami_id"
                orig: "konami_id"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: "4"
                kind: "query"
                name: "level"
                orig: "level"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "link"
                orig: "link"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: "top,bottom"
                kind: "query"
                name: "linkmarker"
                orig: "linkmarker"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "misc"
                orig: "misc"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "Dark Magician"
                kind: "query"
                name: "name"
                orig: "name"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "Wyrm"
                kind: "query"
                name: "race"
                orig: "race"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "scale"
                orig: "scale"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: "name"
                kind: "query"
                name: "sort"
                orig: "sort"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "staple"
                orig: "staple"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "2000-01-01"
                kind: "query"
                name: "startdate"
                orig: "startdate"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "tcgplayer_data"
                orig: "tcgplayer_data"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "Spell Card"
                kind: "query"
                name: "type"
                orig: "type"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/cardinfo.php"
          parts: [
            "cardinfo.php"
          ]
          select: {
            exist: [
              "archetype"
              "atk"
              "attribute"
              "banlist"
              "cardset"
              "dateregion"
              "def"
              "enddate"
              "fname"
              "format"
              "has_effect"
              "id"
              "konami_id"
              "level"
              "link"
              "linkmarker"
              "misc"
              "name"
              "race"
              "scale"
              "sort"
              "staple"
              "startdate"
              "tcgplayer_data"
              "type"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
